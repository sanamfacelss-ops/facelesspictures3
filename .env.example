# Faceless Pictures 3 Environment Configuration

# Application
APP_NAME="Faceless Pictures 3"
APP_ENV=development
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=facelesspictures3
DB_USERNAME=root
DB_PASSWORD=secret
DB_CHARSET=utf8mb4

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# AI Moderation (Local paths)
FFMPEG_PATH=/usr/bin/ffmpeg
NUDENET_MODEL_PATH=/opt/models/nudenet.onnx
WHISPER_MODEL_PATH=/opt/models/whisper-base
UPLOAD_MAX_SIZE=500M

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@facelesspictures.com
MAIL_FROM_NAME="Faceless Pictures"

# Security
SESSION_LIFETIME=120
CSRF_TOKEN_NAME=fp3_csrf_token
