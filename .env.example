# Faceless Pictures 3 Environment Configuration

# Application
APP_NAME="Faceless Pictures 3"
APP_ENV=development
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Debug Mode (enable detailed logging - DISABLE in production!)
FP3_DEBUG=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=facelesspictures3
DB_USERNAME=root
DB_PASSWORD=secret
DB_CHARSET=utf8mb4

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# ============================================
# AI MODERATION APIs (with fallback chain)
# ============================================

# Azure AI Content Safety (Primary - 5K text + 5K images/month free)
# Sign up: https://portal.azure.com -> Create "Content Safety" resource -> F0 tier
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=your_azure_key_here

# OpenAI Moderation (Fallback for text - UNLIMITED free)
# Sign up: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# SightEngine (Fallback for images - 500/month free)
# Sign up: https://sightengine.com
SIGHTENGINE_API_USER=your_user_id
SIGHTENGINE_API_SECRET=your_secret

# RapidAPI / API4AI (Fallback for images - 100/day free)
# Sign up: https://rapidapi.com/api4ai-api4ai-default/api/nsfw3
RAPIDAPI_KEY=your_rapidapi_key_here

# ============================================
# TRANSCRIPTION API
# ============================================

# Groq Whisper API (Unlimited free, 30 RPM rate limit)
# Supports Hindi, Hinglish, English, and 50+ languages
# Sign up: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# ============================================
# LOCAL TOOLS (must be installed on server)
# ============================================

FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
UPLOAD_MAX_SIZE=500M

# Cron Security
CRON_SECRET_KEY=your_random_secret_key_for_cron

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@facelesspictures.com
MAIL_FROM_NAME="Faceless Pictures"

# Security
SESSION_LIFETIME=120
CSRF_TOKEN_NAME=fp3_csrf_token

# ============================================
# GOOGLE OAUTH 2.0 (for social login)
# ============================================
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: YOUR_APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
