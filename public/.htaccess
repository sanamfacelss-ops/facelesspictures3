RewriteEngine On

# Enable OPcache if available
<IfModule mod_php.c>
    php_flag opcache.enable On
    php_value opcache.memory_consumption 128
    php_value opcache.max_accelerated_files 10000
    php_flag opcache.validate_timestamps Off
</IfModule>

# Handle Authorization Header
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE text/xml application/xml application/xhtml+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    # Videos
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    # CSS/JS
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Enable HTTP Range Requests for video streaming
<IfModule mod_headers.c>
    # Enable HTTP/2 Server Push hints
    Header set Link "</assets/css/tailwind.css>; rel=preload; as=style"
    
    # Connection management
    Header set Connection "keep-alive"
    Header set Keep-Alive "timeout=5, max=100"
    
    # Video files
    <FilesMatch "\.(mp4|webm|mov|avi)$">
        Header set Accept-Ranges bytes
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    
    # Images
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        # Prioritize critical images
        Header set Priority "u=2"
    </FilesMatch>
    
    # Fonts
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Priority "u=1"
    </FilesMatch>
    
    # CSS/JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
        Header set Priority "u=0"
    </FilesMatch>
</IfModule>

# Redirect Trailing Slashes If Not A Folder
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# Send Requests To Front Controller
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
